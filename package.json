{
  "name": "eventrahq",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @eventrahq/web",
    "dev:gateway": "node scripts/gateway.mjs",
    "preflight": "node scripts/preflight.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck --workspace @eventrahq/web",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check:native": "node scripts/check-native.mjs",
    "db:start": "supabase start --network-id eventra-local",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "node scripts/test-db.mjs",
    "supabase:setup": "node scripts/supabase.mjs bootstrap",
    "supabase:configure": "node scripts/supabase.mjs configure",
    "supabase:check": "node scripts/supabase.mjs check",
    "seed:development": "node scripts/seed-development.mjs",
    "test:ai": "node scripts/smoke-ai.mjs --run-live",
    "lint": "eslint apps/web/src tests/browser",
    "test:database": "node --test tests/database/*.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@electric-sql/pglite-postgis": "0.2.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "supabase": "2.121.0",
    "typescript-eslint": "8.71.2"
  }
}

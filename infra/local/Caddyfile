    @supabase path /auth/v1 /auth/v1/* /storage/v1 /storage/v1/* /realtime/v1 /realtime/v1/*
    handle @supabase {
        reverse_proxy 127.0.0.1:54321
    }

    handle {
        reverse_proxy 127.0.0.1:3001
    }
}

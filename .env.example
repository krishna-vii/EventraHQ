# Backend settings loaded by npm run dev and supabase:* helpers.
# Copy to .env; never commit it or use NEXT_PUBLIC_* for these values.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3000
NEXT_TELEMETRY_DISABLED=1

# false for Docker-backed Supabase; true explicitly permits managed services.
ALLOW_MANAGED_SERVICES=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Optional absolute path to CA certificate from Supabase Database Settings.
DATABASE_SSLROOTCERT=
# Local: postgresql://eventra_app:URL_ENCODED_PASSWORD@127.0.0.1:54322/postgres
# Managed: copy exact session-pooler host from your project's Connect dialog.
# postgresql://eventra_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# NEVER store the postgres admin URL or a Supabase service_role/secret key here.
# Unset DATABASE_URL selects clearly labeled fictional public discovery only.

INFERENCE_PROVIDER=ollama
INFERENCE_BASE_URL=http://127.0.0.1:11434
INFERENCE_MODEL=qwen3.5:4b
HOSTED_AI_URL=
HOSTED_AI_KEY=
HOSTED_AI_MODEL=

# Test credentials only. No key => checkout explicitly unavailable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Hosted API only: exact lowercase hostname.
API_HOSTNAME=
